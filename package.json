{
  "name": "mirrorconnect",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @mirrorconnect/backend",
    "dev:frontend": "npm run dev --workspace @mirrorconnect/frontend",
    "dev:backend": "npm run dev --workspace @mirrorconnect/backend",
    "build": "npm run build --workspace @mirrorconnect/shared && npm run build --workspace @mirrorconnect/backend && npm run build --workspace @mirrorconnect/frontend",
    "lint": "npm run lint --workspace @mirrorconnect/frontend",
    "migrate:deploy": "npm run migrate:deploy --workspace @mirrorconnect/backend"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "tailwindcss": "4.1.17"
  }
}
