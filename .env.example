# ==========================================
# MirrorConnect Free Cloud Tier Environment Template
# ==========================================

# 1. Database (Neon / Supabase PostgreSQL Free)
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Server & Security Configuration
PORT=4000
NODE_ENV="production"
JWT_SECRET="generate-a-secure-random-32-character-secret-here"

# 3. Session & Cleanup Policies
SESSION_TTL_SECONDS=300
INACTIVITY_TIMEOUT_SECONDS=120

# 4. Free Cloud Production URLs
# Frontend domain on Vercel
PUBLIC_APP_URL="https://mirrorconnect.vercel.app"
FRONTEND_ORIGIN="https://mirrorconnect.vercel.app"
FRONTEND_ORIGIN_2="https://mirrorconnect-frontend.vercel.app"

# Backend domain on Render / Railway (for Frontend Vercel Environment Variables)
NEXT_PUBLIC_API_URL="https://mirrorconnect-backend.onrender.com"
NEXT_PUBLIC_SOCKET_URL="https://mirrorconnect-backend.onrender.com"
NEXT_PUBLIC_APP_URL="https://mirrorconnect.vercel.app"

# 5. Public WebRTC STUN Servers (Default Free Fallback)
STUN_URL="stun:stun.l.google.com:19302"
# Optional TURN server (omitted on free tier)
# TURN_URL="turn:your-turn-server.com:3478"
# TURN_USERNAME="username"
# TURN_PASSWORD="password"
