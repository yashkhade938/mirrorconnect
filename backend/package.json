{
  "name": "@mirrorconnect/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npx prisma generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate:deploy": "npx prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:generate": "npx prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@mirrorconnect/shared": "file:../shared",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.9",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
